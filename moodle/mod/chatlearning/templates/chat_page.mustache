<div class="mod-chatlearning" data-component="chatlearning">
  <div class="app-shell">
    <section class="chat-workspace">
      {{#canmanage}}
      <aside class="panel documents-panel" data-panel="documents">
        <header class="panel-header">
          <h2>{{#str}}label:documents, mod_chatlearning{{/str}}</h2>
        </header>
        <ul class="document-list" data-document-list></ul>
        <p class="status" data-document-status></p>
      </aside>
      {{/canmanage}}

      <article class="panel conversation-panel {{^canmanage}}full-width{{/canmanage}}">
        <header class="panel-header">
          <div>
            <h2>{{#str}}label:chat, mod_chatlearning{{/str}}</h2>
            <p class="panel-description">{{#str}}status:searching, mod_chatlearning{{/str}}</p>
          </div>
        </header>
        <div class="chat-bubbles" data-chat-log></div>
        <form class="chat-form" data-chat-form>
          <textarea name="question" rows="2" placeholder="{{#str}}placeholder:ask, mod_chatlearning{{/str}}" data-chat-input></textarea>
          <button type="submit" class="send-button">{{#str}}label:send, mod_chatlearning{{/str}}</button>
        </form>
        <p class="status" data-chat-status></p>
      </article>
    </section>

    {{#canmanage}}
    <section class="panel tools-panel" data-panel="tools">
      <header class="panel-header">
        <div>
          <h2>{{#str}}label:tools, mod_chatlearning{{/str}}</h2>
          <p class="panel-description">{{#str}}label:syncscope, mod_chatlearning{{/str}}: {{documentscopelabel}}</p>
        </div>
      </header>
      <div class="tools-grid">

      {{#allowuploads}}
      <article class="tool-card">
        <header class="tool-card-header">
          <h3>{{#str}}label:uploads, mod_chatlearning{{/str}}</h3>
          <p class="tool-help">Upload local files and add them to this activity index.</p>
        </header>
        <form class="upload-form" data-upload-form enctype="multipart/form-data">
          <input type="file" name="file" data-upload-input {{#allowedmimetypes}}accept="{{allowedmimetypes}}"{{/allowedmimetypes}} />
          <button type="submit" class="tool-action">Upload and index</button>
          <p class="status" data-upload-status></p>
        </form>
      </article>

      <article class="tool-card">
        <header class="tool-card-header">
          <h3>{{#str}}label:scrape, mod_chatlearning{{/str}}</h3>
          <p class="tool-help">Paste a webpage URL to ingest its text into searchable knowledge.</p>
        </header>
        <form class="scrape-form" data-scrape-form>
          <input type="url" name="url" placeholder="https://example.com/article" data-scrape-input />
          <button type="submit" class="secondary tool-action">Fetch URL and index</button>
          <p class="status" data-scrape-status></p>
        </form>
      </article>
      {{/allowuploads}}

      {{#allowmoodlesync}}
      <article class="tool-card">
        <header class="tool-card-header">
          <h3>{{#str}}label:syncmoodle, mod_chatlearning{{/str}}</h3>
          <p class="tool-help">Import Moodle resources from allowed courses directly into chat indexing.</p>
        </header>
        <form class="sync-form" data-sync-form>
          <label class="source-option">
            <input type="checkbox" data-sync-pdf {{#sourcepdf}}checked{{/sourcepdf}} />
            <span>{{#str}}sourcepdf, mod_chatlearning{{/str}}</span>
          </label>
          <label class="source-option">
            <input type="checkbox" data-sync-scorm {{#sourcescorm}}checked{{/sourcescorm}} />
            <span>{{#str}}sourcescorm, mod_chatlearning{{/str}}</span>
          </label>
          <button type="submit" class="secondary tool-action">{{#str}}label:syncmoodle, mod_chatlearning{{/str}}</button>
          <p class="status" data-sync-status></p>
        </form>
      </article>
      {{/allowmoodlesync}}
      </div>
    </section>
    {{/canmanage}}
  </div>

  <div class="modal-backdrop" data-modal-backdrop></div>
  <div class="modal-dialog" data-modal-dialog>
    <header class="panel-header">
      <h3 data-modal-title>Preview</h3>
      <button type="button" class="secondary" data-modal-close>Close</button>
    </header>
    <iframe class="modal-iframe" data-modal-frame></iframe>
    <a class="header-link" data-modal-download target="_blank" rel="noopener">Download</a>
  </div>
</div>
