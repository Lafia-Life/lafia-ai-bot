<div class="mod-chatlearning" data-component="chatlearning">
  <div class="app-shell">
    {{#allowuploads}}
    <section class="panel" data-panel="uploads">
      <header class="panel-header">
        <h2>{{#str}}label:uploads, mod_chatlearning{{/str}}</h2>
      </header>
      <form class="upload-form" data-upload-form enctype="multipart/form-data">
        <input type="file" name="file" data-upload-input {{#allowedmimetypes}}accept="{{allowedmimetypes}}"{{/allowedmimetypes}} />
        <button type="submit">{{#str}}label:uploads, mod_chatlearning{{/str}}</button>
        <p class="status" data-upload-status></p>
      </form>
      <form class="scrape-form" data-scrape-form>
        <input type="url" name="url" placeholder="https://example.com/article" data-scrape-input />
        <button type="submit" class="secondary">{{#str}}label:scrape, mod_chatlearning{{/str}}</button>
        <p class="status" data-scrape-status></p>
      </form>
    </section>
    {{/allowuploads}}

    <section class="panel" data-panel="documents">
      <header class="panel-header">
        <h2>{{#str}}label:documents, mod_chatlearning{{/str}}</h2>
      </header>
      <ul class="document-list" data-document-list></ul>
    </section>

    <section class="chat-layout">
      <article class="conversation-panel">
        <header class="panel-header">
          <h2>{{#str}}label:chat, mod_chatlearning{{/str}}</h2>
        </header>
        <div class="chat-bubbles" data-chat-log></div>
        <form class="chat-form" data-chat-form>
          <textarea name="question" rows="3" placeholder="Ask a question" data-chat-input></textarea>
          <button type="submit">Ask</button>
        </form>
        <p class="status" data-chat-status></p>
      </article>
      <aside class="reference-panel">
        <header class="panel-header">
          <h2>{{#str}}label:references, mod_chatlearning{{/str}}</h2>
        </header>
        <div class="reference-list" data-reference-list></div>
      </aside>
    </section>
  </div>

  <div class="modal-backdrop" data-modal-backdrop></div>
  <div class="modal-dialog" data-modal-dialog>
    <header class="panel-header">
      <h3 data-modal-title>Preview</h3>
      <button type="button" class="secondary" data-modal-close>Close</button>
    </header>
    <iframe class="modal-iframe" data-modal-frame></iframe>
    <a class="header-link" data-modal-download target="_blank" rel="noopener">Download</a>
  </div>
</div>
