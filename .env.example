# ── LLM provider (OpenAI-compatible) ──────────────────────────────
# Any provider that speaks the OpenAI chat-completions API works.
# Examples: OpenAI, DeepSeek, Groq, Together, Ollama, vLLM.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Backwards-compatible aliases (LLM_* wins if both are set)
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# ── Retrieval embeddings ──────────────────────────────────────────
# hash = no Torch dependency (default for small servers/demos)
# local = sentence-transformers
# openai = OpenAI-compatible embeddings endpoint
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── WHO runtime fetch ─────────────────────────────────────────────
# WHO text is fetched at runtime; it is never committed to the repo.
WHO_SYNC_ON_STARTUP=true
SCRAPER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
SCRAPER_TIMEOUT=20
# SCRAPER_PROXY_URL=http://user:password@proxy-host:3128
# SCRAPER_HTTP2=true

# ── Supabase auth (optional, not required for Lafia) ──────────────
# The current UI does not require an account. These values enable the
# optional /api/auth/* endpoints for a future authenticated deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AUTH_REQUIRED=false
AUTH_COOKIE_SECURE=false

# ── Optional integrations (safe to leave blank) ───────────────────
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
SMS_WEBHOOK_SECRET=
MOODLE_BASE_URL=
MOODLE_TOKEN=
BASE_URL=http://localhost:8000
